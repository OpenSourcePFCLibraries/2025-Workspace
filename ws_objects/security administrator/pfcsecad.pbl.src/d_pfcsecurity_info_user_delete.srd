 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"security_info~" ) COLUMN(NAME=~"security_info.window~") COLUMN(NAME=~"security_info.control~") COLUMN(NAME=~"security_info.user_name~") COLUMN(NAME=~"security_info.application~")WHERE(    EXP1 =~" ~~~"security_info~~~".~~~"user_name~~~"~"   OP =~"=~"    EXP2 =~":username ~" ) ) ARG(NAME = ~"username~" TYPE = string) "
  update="security_info" updatewhere=0 updatekeyinplace=yes
  arguments=(("username", string))
 sort="control A"
)
