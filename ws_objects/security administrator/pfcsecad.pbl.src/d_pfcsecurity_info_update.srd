$PBExportHeader$d_pfcsecurity_info_update.srd
$PBExportComments$Updates the security_info table from the w_pfc_security_info_mgmt window
release 25;
datawindow ( units=0 data.export.format=1 timer_interval=0 processing=1 color=77956459 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=0 print.paper.source=0 grid.lines=0 grid.columnmove=no selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(32) key=yes update=yes updatewhereclause=yes name=application dbname="security_info.application"  )
column=(type=char(64) key=yes update=yes updatewhereclause=yes name=window dbname="security_info.window"  )
column=(type=char(64) key=yes update=yes updatewhereclause=yes name=control dbname="security_info.control"  )
column=(type=char(16) key=yes update=yes updatewhereclause=yes name=user_name dbname="security_info.user_name"  )
column=(type=char(1) update=yes updatewhereclause=yes initial="E" name=status dbname="security_info.status" 
 values="Enabled	E/Disabled	D/Invisible	I/Not Set	N/"  )
column=(type=char(254) updatewhereclause=yes name=description dbname="security_template.description"  )
column=(type=char(24) updatewhereclause=yes name=object_type dbname="security_template.object_type"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"security_template~" )  TABLE(NAME=~"security_info~" ) COLUMN(NAME=~"security_info.application~") COLUMN(NAME=~"security_info.window~") COLUMN(NAME=~"security_info.control~") COLUMN(NAME=~"security_info.user_name~") COLUMN(NAME=~"security_info.status~") COLUMN(NAME=~"security_template.description~") COLUMN(NAME=~"security_template.object_type~")    JOIN (LEFT=~"security_info.application~"    OP =~"=~"RIGHT=~"security_template.application~" )    JOIN (LEFT=~"security_info.window~"    OP =~"=~"RIGHT=~"security_template.window~" )    JOIN (LEFT=~"security_info.control~"    OP =~"=~"RIGHT=~"security_template.control~" )WHERE(    EXP1 =~"( ( security_info.application~"   OP =~"=~"    EXP2 =~":app )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( security_info.window~"   OP =~"=~"    EXP2 =~":window )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( security_info.user_name~"   OP =~"=~"    EXP2 =~":username ) )~" ) ) ARG(NAME = ~"app~" TYPE = string)  ARG(NAME = ~"window~" TYPE = string)  ARG(NAME = ~"username~" TYPE = string) "
  update="security_info" updatewhere=0 updatekeyinplace=yes
  arguments=(("app", string), ("window", string), ("username", string))
 sort="control A"
)
