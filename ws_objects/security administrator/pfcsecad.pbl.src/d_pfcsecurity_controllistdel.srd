$PBExportHeader$d_pfcsecurity_controllistdel.srd
$PBExportComments$Used for deleting all controls for an application, window.
release 25;
datawindow ( units=0 data.export.format=1 timer_interval=0 processing=0 color=1073741824 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=0 print.margin.right=0 print.margin.top=0 print.margin.bottom=0 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=4 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(64) key=yes update=yes updatewhereclause=yes name=window dbname="security_info.window"  )
column=(type=char(64) key=yes update=yes updatewhereclause=yes name=control dbname="security_info.control"  )
column=(type=char(32) key=yes update=yes updatewhereclause=yes name=application dbname="security_info.application"  )
column=(type=char(16) key=yes update=yes updatewhereclause=yes name=user_name dbname="security_info.user_name"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"security_info~" ) COLUMN(NAME=~"security_info.window~") COLUMN(NAME=~"security_info.control~") COLUMN(NAME=~"security_info.application~") COLUMN(NAME=~"security_info.user_name~")WHERE(    EXP1 =~"( security_info.window~"   OP =~"=~"    EXP2 =~":winname )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( security_info.application~"   OP =~"=~"    EXP2 =~":app )~" ) ) ORDER(NAME=~"security_info.control~" ASC=yes ) ARG(NAME = ~"app~" TYPE = string)  ARG(NAME = ~"winname~" TYPE = string) "
  update="security_info" updatewhere=0 updatekeyinplace=no
  arguments=(("app", string), ("winname", string))
 sort="control A"
)
