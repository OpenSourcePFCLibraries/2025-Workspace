 values=""  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sales_order~" ) COLUMN(NAME=~"sales_order.id~") COLUMN(NAME=~"sales_order.cust_id~") COLUMN(NAME=~"sales_order.order_date~") COLUMN(NAME=~"sales_order.fin_code_id~") COLUMN(NAME=~"sales_order.region~") COLUMN(NAME=~"sales_order.sales_rep~")WHERE(    EXP1 =~"( ( sales_order.cust_id~"   OP =~"=~"    EXP2 =~":cust_id )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( sales_order.sales_rep~"   OP =~"=~"    EXP2 =~":sales_rep ) )~" ) ) ORDER(NAME=~"sales_order.id~" ASC=yes ) ARG(NAME = ~"cust_id~" TYPE = number)  ARG(NAME = ~"sales_rep~" TYPE = number) "
  update="sales_order" updatewhere=0 updatekeyinplace=no
  arguments=(("cust_id", number), ("sales_rep", number))
)
