column=(type=char(12) update=yes updatewhereclause=yes name=customer_phone dbname="customer.phone"  )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"customer~" )  TABLE(NAME=~"states~" ) COLUMN(NAME=~"customer.id~") COLUMN(NAME=~"customer.company_name~") COLUMN(NAME=~"customer.lname~") COLUMN(NAME=~"customer.fname~") COLUMN(NAME=~"customer.address~") COLUMN(NAME=~"customer.city~") COLUMN(NAME=~"customer.state~") COLUMN(NAME=~"customer.zip~") COLUMN(NAME=~"customer.phone~")    JOIN (LEFT=~"states.state_id~"    OP =~"=~"RIGHT=~"customer.state~" )WHERE(    EXP1 =~"~~~"states~~~".~~~"region~~~"~"   OP =~"=~"    EXP2 =~":region~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"customer~~~".~~~"state~~~"~"   OP =~"=~"    EXP2 =~":state_id~" ) ) ORDER(NAME=~"customer.company_name~" ASC=yes ) ARG(NAME = ~"region~" TYPE = string)  ARG(NAME = ~"state_id~" TYPE = string) "
  update="customer" updatewhere=0 updatekeyinplace=yes
  arguments=(("region", string), ("state_id", string))
)
