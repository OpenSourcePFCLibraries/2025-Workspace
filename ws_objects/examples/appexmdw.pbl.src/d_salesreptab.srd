$PBExportHeader$d_salesreptab.srd
$PBExportComments$Tabular presentation of sales rep data.  Updateable for w_tablink.
release 25;
datawindow ( units=0 data.export.format=1 timer_interval=0 processing=0 color=79741120 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=88 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long key=yes updatewhereclause=yes name=emp_id dbname="employee.emp_id"  )
column=(type=char(20) update=yes updatewhereclause=yes name=emp_fname dbname="employee.emp_fname"  )
column=(type=char(20) update=yes updatewhereclause=yes name=emp_lname dbname="employee.emp_lname"  )
column=(type=long update=yes updatewhereclause=yes name=manager_id dbname="employee.manager_id"  )
column=(type=char(10) update=yes updatewhereclause=yes name=phone dbname="employee.phone"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"employee~" ) COLUMN(NAME=~"employee.emp_id~") COLUMN(NAME=~"employee.emp_fname~") COLUMN(NAME=~"employee.emp_lname~") COLUMN(NAME=~"employee.manager_id~") COLUMN(NAME=~"employee.phone~")WHERE(    EXP1 =~"~~~"employee~~~".~~~"dept_id~~~"~"   OP =~"=~"    EXP2 =~"200~" ) ) "
  update="employee" updatewhere=0 updatekeyinplace=no
 )
