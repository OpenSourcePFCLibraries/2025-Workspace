global m_sheetframe m_sheetframe

on m_sheetframe.create
m_sheetframe=this
call super::create
end on

on m_sheetframe.destroy
call super::destroy
end on

on m_new.create
call super::create
this.ToolBarItemName="ScriptNo!"
this.MicroHelp="Opens another sheet"
end on

