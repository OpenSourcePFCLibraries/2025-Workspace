 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"examples_categories_list~" ) COLUMN(NAME=~"examples_categories_list.category_id~") COLUMN(NAME=~"examples_categories_list.category_name~") COLUMN(NAME=~"examples_categories_list.category_parent_id~") COLUMN(NAME=~"examples_categories_list.example_id~") COLUMN(NAME=~"examples_categories_list.picture_idx~") COLUMN(NAME=~"examples_categories_list.selected_picture_idx~") COLUMN(NAME=~"examples_categories_list.state_picture_idx~") COLUMN(NAME=~"examples_categories_list.overlay_picture_idx~")WHERE(    EXP1 =~"( examples_categories_list.category_parent_id~"   OP =~"=~"    EXP2 =~":ai_categoryid )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"examples_categories_list.example_id~"   OP =~"in~"    EXP2 =~"( SELECT examples.example_id FROM examples WHERE (examples.ostype like :as_ostype ) )~" ) ) ORDER(NAME=~"examples_categories_list.category_name~" ASC=yes ) ARG(NAME = ~"ai_categoryid~" TYPE = number)  ARG(NAME = ~"as_ostype~" TYPE = string) "
  update="examples_categories_list" updatewhere=0 updatekeyinplace=no
  arguments=(("ai_categoryid", number), ("as_ostype", string))
)
