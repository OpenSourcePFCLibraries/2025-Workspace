table(column=(type=char(60) update=yes updatewhereclause=yes name=title dbname="examples.title"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=example_id dbname="examples.example_id"  )
column=(type=char(128) update=yes updatewhereclause=yes name=window dbname="examples.window"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"examples~" ) COLUMN(NAME=~"examples.title~") COLUMN(NAME=~"examples.example_id~") COLUMN(NAME=~"examples.window~") WHERE(    EXP1 =~"~~~"examples~~~".~~~"window~~~"~"   OP =~"=~"    EXP2 =~":classname~" ) ) ARG(NAME = ~"classname~" TYPE = number) "
  update="examples" updatewhere=1 updatekeyinplace=no
  arguments=(("classname", string))
)
