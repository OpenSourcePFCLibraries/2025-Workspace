 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"examples_categories_list~" ) COLUMN(NAME=~"examples_categories_list.category_id~") COLUMN(NAME=~"examples_categories_list.category_name~") COLUMN(NAME=~"examples_categories_list.category_parent_id~") COLUMN(NAME=~"examples_categories_list.example_id~") COLUMN(NAME=~"examples_categories_list.picture_idx~") COLUMN(NAME=~"examples_categories_list.selected_picture_idx~") COLUMN(NAME=~"examples_categories_list.overlay_picture_idx~") COLUMN(NAME=~"examples_categories_list.state_picture_idx~")WHERE(    EXP1 =~"( examples_categories_list.category_parent_id~"   OP =~"=~"    EXP2 =~":category_id )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( examples_categories_list.example_id~"   OP =~"=~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( examples_categories_list.category_id~"   OP =~"<>~"    EXP2 =~":category_id )~" ) ) ARG(NAME = ~"category_id~" TYPE = number) "
