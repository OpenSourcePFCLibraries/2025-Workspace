$PBExportHeader$d_project_analyzer_report.srd
$PBExportComments$Report window for project analyzer
release 25;
datawindow ( units=0 data.export.format=1 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=401 color="536870912" )
summary(height=1 color="536870912" )
footer(height=1 color="536870912" )
detail(height=557 color="536870912"  height.autosize=yes)
table(column=(type=char(50) updatewhereclause=yes name=name dbname="project.name"  )
column=(type=char(50) updatewhereclause=yes name=project_leader dbname="project.project_leader"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"project~" ) COLUMN(NAME=~"project.name~") COLUMN(NAME=~"project.project_leader~")WHERE(    EXP1 =~"project.project_id~"   OP =~"=~"    EXP2 =~":project_id~" ) ) ARG(NAME = ~"project_id~" TYPE = number)  ARG(NAME = ~"deviation~" TYPE = number) "
  arguments=(("project_id", number), ("deviation", number))
)
bitmap(band=header filename="peat.bmp" x="19" y="12" height="129" width="147" border="0"  originalsize=no )
line(band=header background.mode="1" background.color="553648127" pen.style="0" pen.width="10" pen.color="0" x1="5" y1="388" x2="3507" y2="388" )
line(band=header background.mode="1" background.color="553648127" pen.style="0" pen.width="10" pen.color="0" x1="5" y1="372" x2="3507" y2="372" )
column(name=name band=header id=1 x="5" y="12" height="85" width="3498" color="0" border="0" alignment="2" format="[general]" edit.autohscroll=no edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=50 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="1" background.color="536870912" font.charset="0" font.face="MS Sans Serif" font.family="2" font.height="-12" font.pitch="2" font.weight="700" tabsequence=0 )
compute(band=header font.charset="0" font.face="MS Sans Serif" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="1" y="248" height="77" width="1299" format="[general]" expression="~"Project Leader:  ~" +  project_leader " alignment="0" border="0" crosstab.repeat=no )
compute(band=header font.charset="0" font.face="MS Sans Serif" font.family="2" font.height="-10" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="2812" y="252" height="73" width="668" format="[general]" expression="'Page ' + page() + ' of ' + pageCount()" alignment="1" border="0" crosstab.repeat=no )
text(band=header font.charset="0" font.face="MS Sans Serif" font.family="2" font.height="-12" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="1418" y="108" height="81" width="668" text="Project Analyzer" )
compute(band=header font.charset="0" font.face="MS Sans Serif" font.family="2" font.height="-10" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" x="1418" y="212" height="81" width="668" format="[general]" expression="~"Deviation:  ~" +  (deviation * 100) + ~"%~"" alignment="2" border="0" crosstab.repeat=no )
report(name=summary height.autosize=yes slideup=directlyabove band=detail x="1" y="28" height="137" width="3077" border="0" trail_footer=yes criteria="" dataobject="d_project_analyzer_summary" nest_arguments=
(("project_id")) )
report(height.autosize=yes slideup=directlyabove band=detail x="74" y="188" height="137" width="2666" border="0" trail_footer=yes criteria="" dataobject="d_project_category_deviations" nest_arguments=
