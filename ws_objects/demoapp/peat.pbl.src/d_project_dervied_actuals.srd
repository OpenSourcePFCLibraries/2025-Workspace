 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"project_derived_item~" ) COLUMN(NAME=~"project_derived_item.name~") COLUMN(NAME=~"project_derived_item.percentage~") COLUMN(NAME=~"project_derived_item.actual_hours~") COLUMN(NAME=~"project_derived_item.derived_item_id~") COLUMN(NAME=~"project_derived_item.project_id~")WHERE(    EXP1 =~"project_derived_item.project_id~"   OP =~"=~"    EXP2 =~":project_id~" ) ) ARG(NAME = ~"project_id~" TYPE = number) "
  update="project_derived_item" updatewhere=0 updatekeyinplace=no
  arguments=(("project_id", number))
)
