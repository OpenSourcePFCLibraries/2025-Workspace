$PBExportHeader$d_project_estimates.srd
$PBExportComments$The tabular datawindow used to enter project estimates
release 25;
datawindow ( units=0 data.export.format=1 timer_interval=0 processing=0 color=80263328 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=76 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=100 color="536870912" )
table(column=(type=char(50) update=yes updatewhereclause=yes validationmsg="~"Item Name is required.~"" name=project_category_item_name dbname="project_category_item.name"  )
column=(type=long update=yes updatewhereclause=yes validationmsg="~"Complexity is required.~"" name=project_category_item_complexity_id dbname="project_category_item.complexity_id" 
 values=""  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=project_category_item_estimated_hours dbname="project_category_item.estimated_hours"  )
column=(type=long update=yes updatewhereclause=yes validationmsg="~"Role is required.~"" name=project_category_item_role_id dbname="project_category_item.role_id" 
 values=""  )
column=(type=long key=yes update=yes updatewhereclause=yes name=project_category_item_category_id dbname="project_category_item.category_id"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=project_category_item_project_id dbname="project_category_item.project_id"  )
column=(type=long key=yes identity=yes update=yes updatewhereclause=yes initial="AUTOINCREMENT" name=project_category_item_category_item_id dbname="project_category_item.category_item_id"  )
column=(type=decimal(4) updatewhereclause=yes name=adjusted_hours dbname="compute_0008"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"project_category_item~" )  TABLE(NAME=~"project_role~" ) COLUMN(NAME=~"project_category_item.name~") COLUMN(NAME=~"project_category_item.complexity_id~") COLUMN(NAME=~"project_category_item.estimated_hours~") COLUMN(NAME=~"project_category_item.role_id~") COLUMN(NAME=~"project_category_item.category_id~") COLUMN(NAME=~"project_category_item.project_id~") COLUMN(NAME=~"project_category_item.category_item_id~") COMPUTE(NAME=~"(project_category_item.estimated_hours * project_role.multipler)    ~")    JOIN (LEFT=~"project_role.role_id~"    OP =~"=~"RIGHT=~"project_category_item.role_id~" )    JOIN (LEFT=~"project_role.project_id~"    OP =~"=~"RIGHT=~"project_category_item.project_id~" )WHERE(    EXP1 =~"( ( project_category_item.project_id~"   OP =~"=~"    EXP2 =~":project_id ) )~" ) ) ARG(NAME = ~"project_id~" TYPE = number) "
  update="project_category_item" updatewhere=1 updatekeyinplace=yes
  arguments=(("project_id", number))
)
