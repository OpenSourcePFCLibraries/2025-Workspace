detail(height=292 color="536870912" )
table(column=(type=char(50) update=yes updatewhereclause=yes validationmsg="~"Project Name is required.~"" name=name dbname="project.name"  )
column=(type=char(50) update=yes updatewhereclause=yes name=project_leader dbname="project.project_leader"  )
column=(type=date update=yes updatewhereclause=yes name=start_date dbname="project.start_date"  )
column=(type=date update=yes updatewhereclause=yes name=end_date dbname="project.end_date"  )
column=(type=long key=yes identity=yes update=yes updatewhereclause=yes name=project_id dbname="project.project_id"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"project~" ) COLUMN(NAME=~"project.name~") COLUMN(NAME=~"project.project_leader~") COLUMN(NAME=~"project.start_date~") COLUMN(NAME=~"project.end_date~") COLUMN(NAME=~"project.project_id~")WHERE(    EXP1 =~"project.project_id~"   OP =~"=~"    EXP2 =~":projec_id~" ) ) ARG(NAME = ~"projec_id~" TYPE = number) "
  update="project" updatewhere=1 updatekeyinplace=yes
  arguments=(("projec_id", number))
)
