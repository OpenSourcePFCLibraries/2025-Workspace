footer(height=0 color="536870912" )
detail(height=100 color="536870912" )
table(column=(type=char(50) update=yes updatewhereclause=yes name=name dbname="project_category_item.name"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=estimated_hours dbname="project_category_item.estimated_hours"  )
column=(type=decimal(2) update=yes updatewhereclause=yes name=actual_hours dbname="project_category_item.actual_hours"  )
column=(type=long key=yes updatewhereclause=yes name=default_category_id dbname="project_category_item.category_id"  )
column=(type=long key=yes identity=yes update=yes updatewhereclause=yes initial="AUTOINCREMENT" name=project_category_item_category_item_id dbname="project_category_item.category_item_id"  )
column=(type=long key=yes update=yes updatewhereclause=yes name=project_category_item_project_id dbname="project_category_item.project_id"  )
column=(type=decimal(4) updatewhereclause=yes name=compute_0007 dbname="compute_0007"  )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"project_category_item~" )  TABLE(NAME=~"project_role~" ) COLUMN(NAME=~"project_category_item.name~") COLUMN(NAME=~"project_category_item.estimated_hours~") COLUMN(NAME=~"project_category_item.actual_hours~") COLUMN(NAME=~"project_category_item.category_id~") COLUMN(NAME=~"project_category_item.category_item_id~") COLUMN(NAME=~"project_category_item.project_id~") COMPUTE(NAME=~"project_category_item.estimated_hours * project_role.multipler~")    JOIN (LEFT=~"project_role.role_id~"    OP =~"=~"RIGHT=~"project_category_item.role_id~" )    JOIN (LEFT=~"project_role.project_id~"    OP =~"=~"RIGHT=~"project_category_item.project_id~" )WHERE(    EXP1 =~"( project_category_item.project_id~"   OP =~"=~"    EXP2 =~":project_id )~" ) ) ORDER(NAME=~"project_category_item.name~" ASC=yes ) ARG(NAME = ~"project_id~" TYPE = number) "
  update="project_category_item" updatewhere=1 updatekeyinplace=yes
  arguments=(("project_id", number))
 sort="name A"
)
