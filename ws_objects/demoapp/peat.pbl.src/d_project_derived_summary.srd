$PBExportHeader$d_project_derived_summary.srd
$PBExportComments$The tabular datawindow used to show derived summary information
release 25;
datawindow ( units=0 data.export.format=1 timer_interval=0 processing=0 color=16777215 brushmode=0 transparency=0 gradient.color=8421504 gradient.transparency=0 gradient.angle=0 gradient.repetition.mode=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.focus=0 gradient.scale=100 gradient.spread=100 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.clip.bottom=0 picture.blur=0 picture.transparency=0 print.documentname=""  print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 selected.mouse=no hidegrayline=no showbackcoloronxp=no)
header(height=173 color="536870912" )
summary(height=117 color="536870912" )
footer(height=1 color="536870912" )
detail(height=81 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=name dbname="project_derived_item.name"  )
column=(type=decimal(2) updatewhereclause=yes name=percentage dbname="project_derived_item.percentage"  )
column=(type=decimal(2) updatewhereclause=yes name=rate dbname="project_derived_item.rate"  )
column=(type=decimal(4) updatewhereclause=yes name=compute_0004 dbname="compute_0004"  )
 retrieve="  SELECT project_derived_item.name,   
         project_derived_item.percentage,   
         project_derived_item.rate,   
            (SELECT sum(project_category_item.estimated_hours*    
        					  project_role.multipler ) 
    			FROM project_category_item,   
        				project_complexity,   
        				project_role  
  				 WHERE ( project_complexity.complexity_id = project_category_item.complexity_id ) and  
       				  ( project_category_item.role_id = project_role.role_id ) and  
       				  ( ( project_category_item.project_id = :project_id) ))
      FROM project_derived_item
   WHERE project_derived_item.project_id = :project_id  
"
  arguments=(("project_id", number))
)
line(band=header background.mode="1" background.color="553648127" pen.style="0" pen.width="5" pen.color="0" x1="1" y1="144" x2="3479" y2="144" )
text(name=default_derived_item_percentage_t band=header font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="1180" y="68" height="53" width="234" text="Percent" )
text(name=default_derived_item_name_t band=header font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="19" y="68" height="53" width="417" text="Derived Items" )
text(band=header font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="2945" y="68" height="53" width="421" text="Estimated Cost" )
text(name=default_derived_item_rate_t band=header font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="1587" y="72" height="53" width="298" text="Rate" )
text(band=header font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="2" border="0" x="1966" y="12" height="53" width="764" text="Estimated Hrs" )
compute(band=header font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="1966" y="68" height="57" width="764" format="[general]" expression="~"(% * ~" +  String(compute_0004) + ~" hrs)~"" alignment="2" border="0" crosstab.repeat=no )
compute(name=total_estimated_cost band=summary font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="2945" y="36" height="69" width="348" format="$#,##0.00;[RED]($#,##0.00)" expression=" sum( adjusted_hours * rate  for all)" alignment="1" border="0" crosstab.repeat=no )
text(band=summary font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="700" background.mode="1" background.color="536870912" color="0" alignment="0" border="0" x="714" y="36" height="53" width="156" text="Total" )
line(band=summary background.mode="1" background.color="536870912" pen.style="0" pen.width="5" pen.color="0" x1="2853" y1="20" x2="3425" y2="20" )
line(band=summary background.mode="1" background.color="536870912" pen.style="0" pen.width="5" pen.color="0" x1="2163" y1="20" x2="2538" y2="20" )
compute(name=total_estimated_hours band=summary font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="1966" y="36" height="69" width="764" format="#,##0.00" expression="sum( compute_0004 * (percentage / 100) for all)" alignment="2" border="0" crosstab.repeat=no )
compute(band=detail font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="1180" y="4" height="65" width="234" format="[general]" expression=" percentage  + ~"%~"" alignment="2" border="0" crosstab.repeat=no )
compute(band=detail font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="2945" y="4" height="65" width="348" format="$#,##0.00;[RED]($#,##0.00)" expression="adjusted_hours * rate" alignment="1" border="0" crosstab.repeat=no )
column(name=name band=detail id=1 x="19" y="4" height="65" width="1020" color="0" border="0" alignment="0" format="[general]" edit.autohscroll=no edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="2" background.color="16777215" font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" tabsequence=0 )
column(name=rate band=detail id=3 x="1587" y="4" height="65" width="211" color="0" border="0" alignment="1" format="$#,##0.00;($#,##0.00)" edit.autohscroll=no edit.autoselect=yes edit.autovscroll=no edit.case=any edit.codetable=no edit.displayonly=no edit.hscrollbar=no edit.imemode=0 edit.limit=0 edit.password=no edit.vscrollbar=no edit.validatecode=no edit.nilisnull=no edit.required=no edit.useellipsis=no criteria.required=no criteria.override_edit=no crosstab.repeat=no background.mode="2" background.color="16777215" font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" tabsequence=0 )
compute(name=adjusted_hours band=detail font.charset="0" font.face="Segoe UI" font.family="2" font.height="-8" font.pitch="2" font.weight="400" background.mode="1" background.color="536870912" color="0" x="1966" y="4" height="65" width="764" format="#,##0.00" expression="compute_0004 * (percentage / 100)" alignment="2" border="0" crosstab.repeat=no )
htmltable()
htmlgen(pagingMethod=0 )
xhtmlgen() cssgen()
xmlgen()
xsltgen()
jsgen()
export.xml(metadatatype=0 savemetadata=0 )
import.xml()
export.pdf(method=2 nativepdf.customsize=0 nativepdf.customorientation=0 nativepdf.pdfstandard=0 nativepdf.useprintspec=no nativepdf.imageformat=0 )
export.xhtml()
